# Server-only. Supabase Connect > Shared Pooler > Transaction mode, port 6543.
# postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres
# Never restore a MySQL/TiDB URL. Keep real credentials out of source control.
DATABASE_URL=
